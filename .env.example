# Copy to .env and fill in real values. .env is gitignored; never commit it.
# Blank values and your-...-here placeholders are treated as "not set".

# --- Required for real runs (tests and mock mode need none of these) ---
OPENAI_API_KEY=your-openai-api-key-here
GITHUB_TOKEN=your-github-token-here
# Public tickets repo as owner/repo
TICKETS_REPO=your-owner/your-tickets-repo-here

# --- Optional: tracing (FR-F6). The app runs without them. ---
LANGSMITH_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse region or self-hosted URL, e.g. https://us.cloud.langfuse.com. Blank means the EU cloud host.
LANGFUSE_HOST=

# --- Optional: cache (FR-F6). Falls back to in-memory when blank. ---
REDIS_URL=

# --- Optional: salt for masked user IDs in traces and rate-limit keys (FR-G11). Set a long random string;
# when blank the app uses a built-in salt (weaker: the hashes of known emails can be recomputed) and warns once. ---
MASK_SALT=

# Optional, tests only: run the answer-cache tests against a real Redis too (they use a fake client without this).
# SMARTDESK_TEST_REDIS_URL=redis://localhost:6379/15

# Optional, process environment only (not read from this file): switch a mode for one run without editing config.yaml.
# Example, a live LLM with mock tickets:  SMARTDESK_LLM_MODE=live SMARTDESK_TICKETS_MODE=mock streamlit run smartdesk_ai/ui/app.py
# SMARTDESK_LLM_MODE=mock|live
# SMARTDESK_TICKETS_MODE=mock|live

# Optional: where the CLI keeps its runtime files (index, chat checkpoints, ticket map). Default: ./data
# SMARTDESK_DATA_DIR=
