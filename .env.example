# Copy to .env and fill in real values. .env is gitignored; never commit it.
# Blank values and your-...-here placeholders are treated as "not set".

# --- Required for real runs (tests and mock mode need none of these) ---
OPENAI_API_KEY=your-openai-api-key-here
GITHUB_TOKEN=your-github-token-here
# Public tickets repo as owner/repo
TICKETS_REPO=your-owner/your-tickets-repo-here

# --- Optional: tracing (FR-F6). The app runs without them. ---
LANGSMITH_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Optional: cache (FR-F6). Falls back to in-memory when blank. ---
REDIS_URL=
