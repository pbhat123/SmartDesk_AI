#!/bin/bash
# Commit gate. Installed with: scripts/install_hooks.sh   (sets git config core.hooksPath scripts/git-hooks)
#   1. The whole test suite must pass, collection included.
#   2. If a staged file is under smartdesk_ai/ or is scripts/smoke_ui.py, scripts/smoke_ui.py must pass too.
# They run one after the other, never together (two heavy runs at once crashed the editor). Either failing blocks the
# commit. There is no skip flag; `git commit --no-verify` is a deliberate act the project rules forbid.
cd "$(git rev-parse --show-toplevel)" || exit 1
PY=.venv/bin/python
[ -x "$PY" ] || PY=python
LIMIT=600  # seconds for the whole of pytest, and again for smoke: a hung run fails the commit instead of waiting for ever
RUN="$PY scripts/run_with_limit.py $LIMIT --"
echo "pre-commit: running pytest ..."
if ! $RUN "$PY" -m pytest -q -p no:cacheprovider; then
  echo "pre-commit: pytest FAILED or hung past ${LIMIT}s, commit blocked. Fix the failure and commit again." >&2
  exit 1
fi
echo "pre-commit: pytest green."
if git diff --cached --name-only | grep -qE '^(smartdesk_ai/|scripts/smoke_ui\.py$)'; then
  echo "pre-commit: app code or the smoke test is staged, running scripts/smoke_ui.py ..."
  if ! $RUN "$PY" scripts/smoke_ui.py; then
    echo "pre-commit: smoke_ui.py FAILED or hung past ${LIMIT}s, commit blocked. Fix the failure and commit again." >&2
    exit 1
  fi
  echo "pre-commit: smoke_ui.py green."
else
  echo "pre-commit: no app code or smoke test staged, smoke_ui.py not needed."
fi
